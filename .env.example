# Copy this file to .env and update the values for production

# JWT secret used by the backend to sign tokens
# IMPORTANT: Generate a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string

# JWT token expiration (e.g. 1d, 7d, 1h)
JWT_EXPIRES_IN=1d

# Optional: restrict CORS to your frontend domain(s)
# Leave empty for local dev (allows all origins)
# For production: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# Telegram Bot notifications (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_CHAT_ID=your-chat-id-or-group-id
